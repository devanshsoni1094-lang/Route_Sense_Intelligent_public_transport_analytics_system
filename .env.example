# Route Sense India — Environment Variables Configuration

# 1. Application & Regional Defaults
PROJECT_NAME="Route Sense — Intelligent Public Transport Analytics System"
NEXT_PUBLIC_DEFAULT_COUNTRY="IN"
TIMEZONE="Asia/Kolkata"

# 2. Google Maps Platform API Credentials
# Server Key (Restricted to Places API, Routes API, Directions API, Geocoding API)
# Strictly server-side only: never exposed to browser bundles
GOOGLE_MAPS_SERVER_API_KEY=your_restricted_server_key_here

# Browser Key (Optional: only needed if using Maps JavaScript API on client with HTTP Referrer restriction)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your_restricted_browser_key_here

# Backward Compatibility Alias (Optional)
GOOGLE_MAPS_API_KEY=

# 3. Database & System Settings
DATABASE_URL="sqlite:///./iptap.db"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
DEMO_MODE=false
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
