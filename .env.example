# Route Sense India — Environment Variables Configuration

# Application & Region Defaults
PROJECT_NAME="Route Sense — Intelligent Public Transport Analytics System"
NEXT_PUBLIC_DEFAULT_COUNTRY="IN"
TIMEZONE="Asia/Kolkata"

# Provider Configurations
# Location Geocoding & Autocomplete Provider: 'nominatim' | 'indian_transit_db' | 'google' | 'mappls'
NEXT_PUBLIC_MAP_PROVIDER="nominatim"
GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"
GOOGLE_MAPS_MAP_ID="your-google-maps-map-id-here"
MAPPLS_ACCESS_TOKEN="your-mappls-access-token-here"

# Transit Routing Engine Configuration
TRANSIT_ROUTING_PROVIDER="indian_transit_engine"
TRANSIT_ROUTING_API_KEY="your-transit-routing-api-key-here"

# API & Security Settings
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
DATABASE_URL="sqlite:///./iptap.db"
DEMO_MODE=false
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
