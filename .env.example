# IPTAP Environment Variables Example
PROJECT_NAME="Intelligent Public Transport Analytics Platform (IPTAP)"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iptap_db"
TIMEZONE="Asia/Kolkata"
DEFAULT_AGENCY_NAME="Bengaluru Metropolitan Transport Corporation (BMTC)"
DEFAULT_AGENCY_ID="BMTC_BLR"
DEMO_MODE=true
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
